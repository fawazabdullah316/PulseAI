# ─────────────────────────────────────────────────────────────────────────
# PULSEAI — Environment Variables
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env with real values to git. It's already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Database (PostgreSQL — required for production) ───────────────────────
# If unset, pipeline.py automatically falls back to a local SQLite file.
# That fallback is fine for local dev but NOT safe under concurrent writes
# in production — set this for any real deployment.
DATABASE_URL=postgresql://pulseai:CHANGE_ME@localhost:5432/pulseai
POSTGRES_PASSWORD=CHANGE_ME

# ── Cache + Async Queue (Redis) ─────────────────────────────────────────
# If unset: in-memory cache is used (single-process only) and the
# /analyse/async endpoint is disabled (falls back to BackgroundTask).
REDIS_URL=redis://localhost:6379/0

# ── API Authentication ──────────────────────────────────────────────────
# If unset, /analyse, /analyse/async, /result, and /history are UNPROTECTED.
# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
PULSEAI_API_KEY=CHANGE_ME

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list. Use "*" only for local dev.
PULSEAI_ALLOWED_ORIGINS=https://app.yourdomain.com,https://dashboard.yourdomain.com

# ── Datadog (optional — metrics ingestion for incident analysis) ──────────
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ── GitHub (optional — commit correlation) ──────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=abdullah7796/pulseai

# ── AWS CloudWatch (optional — log ingestion) ───────────────────────────
AWS_REGION=ap-south-2
CLOUDWATCH_LOG_GROUP=/ecs/RootAi
# AWS credentials are picked up from the standard chain (env vars,
# ~/.aws/credentials, or IAM role) — not set directly here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Slack notifications (optional) ──────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── PagerDuty webhook verification (optional but recommended) ───────────
PAGERDUTY_WEBHOOK_SECRET=

# ── Gunicorn ─────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_BIND=0.0.0.0:8000
LOG_LEVEL=info

# ── Prometheus ───────────────────────────────────────────────────────────
# Only relevant for production multi-worker Gunicorn deployments — leave
# this commented out for local/single-process runs. The app picks a safe
# cross-platform default on its own (your system's temp folder) if unset.
#PROMETHEUS_MULTIPROC_DIR=/tmp/pulseai_prom

# ── Grafana (docker-compose only) ───────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
